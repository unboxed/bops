<head>
  <meta charset="utf-8">

  <title>
    <%= content_for?(:page_title) ? yield(:page_title) : t("page_title") %>
  </title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  >

  <meta name="theme-color" content="blue">

  <%= favicon_link_tag("b-favicon.ico") %>
  <%= favicon_link_tag("b-apple-touch-icon.png", rel: "apple-touch-icon", type: "image/png") %>
  <%= favicon_link_tag("b-mask-icon.svg", rel: "mask-icon") %>

  <%= stylesheet_link_tag "application", media: "all" %>
  <%= javascript_include_tag "application", nonce: true %>

  <meta
    property="og:image"
    content="&lt;YOUR-DOMAIN&gt;/images/govuk-opengraph-image.png"
  >
</head>
