<%= render @enforcement %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds" id="dates-and-assignment-details">
    <p class="govuk-body">
      Assigned to:
      <strong><%= @enforcement.user&.name || "Unassigned" %></strong>
      <%= govuk_link_to (@enforcement.user.present? ? "Change" : "Assign application"), assign_users_path(@enforcement) %>
    </p>
  </div>
</div>

<div class="status-bar-container" id="dates-details">
  <div class="status-bar">
    <div class="status-panel" id="started-date">
      <p class="govuk-body">
        Investigation started
      </p>

      <p>
        <% if @enforcement.under_investigation? %>
          <strong><%= @enforcement.under_investigation_at.to_date.to_fs %></strong>
        <% else %>
          Not yet started
        <% end %>
      </p>
    </div>

    <div class="status-panel" id="target-date">
      <p class="govuk-body">
        Site visit target date
      </p>

      <p>
        <strong>
          <% if @enforcement.target_date %>
            <strong><%= @enforcement.target_date.to_fs %></strong>
          <% else %>
            Not yet started
          <% end %>
        </strong>
      </p>
    </div>

    <div class="status-panel" id="expiry-date">
      <p class="govuk-body">
        Notice served
      </p>

      <p>
        <strong>
          <% if @enforcement.notice_served_at %>
            <%= @enforcement.notice_served_at_at.to_date.to_fs %>
          <% else %>
            None served
          <% end %>
        </strong>
      </p>
    </div>
  </div>
</div>

<%= render "accordion" %>

<div id="enforcement-tasks">
  <% @grouped_tasks.each do |section, tasks| %>
    <h2 class="govuk-!-margin-top-9 application-step-heading">
      <%= section %>
    </h2>

    <%= govuk_task_list(id_prefix: "#{section}-section", html_attributes: {id: "#{section}-section"}) do |task_list| %>
      <% tasks.each do |task| %>
        <% if @enforcement.closed? %>
          <% task_list.with_item(title: task.name) %>
        <% else %>
          <% task_list.with_item(
               title: task.name,
               href: task_path(@enforcement, task),
               status: task_status_tag(task)
             ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>

<%= govuk_button_link_to "Close the case", task_path(@enforcement, "close-case"), warning: true %>
