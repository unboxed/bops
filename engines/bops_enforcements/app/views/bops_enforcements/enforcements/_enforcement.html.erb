<%# locals: (enforcement:, task: nil, title: nil) %>

<% add_parent_breadcrumb_link "Home", root_path %>
<% add_parent_breadcrumb_link "Application", enforcement_path(@enforcement) %>

<% page_heading = title || task&.title || "Enforcement case" %>

<% if task && !current_page?(task&.url) %>
  <% add_parent_breadcrumb_link page_heading, task.url %>
<% end %>

<% content_for :page_title do %>
  <%= page_heading %> &mdash; <%= t("page_title") %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds" id="case-details">
    <h1>
      <%= page_heading %>
    </h1>

    <p class="govuk-body">
      <strong><%= enforcement.address %></strong>
      <br>
      Case reference <strong><%= enforcement.reference %></strong>
    </p>

    <div id="case-statuses-tags">
      <p class="govuk-body">
        <span class="govuk-!-margin-left-1">
          <%= govuk_tag(text: enforcement.status.humanize, colour: enforcement.status_tag_colour) %>
        </span>

        <% if enforcement.urgent? %>
          <span class="govuk-!-margin-left-1"><%= govuk_tag(text: "urgent", colour: "orange") %></span>
        <% end %>
      </p>
    </div>

    <p class="govuk-body">
      <%= enforcement.description || "No description" %>
    </p>
  </div>
</div>
