<%= govuk_accordion do |accordion| %>
  <%= accordion.with_section(heading_text: "Breach report") do %>
    <%= govuk_table do |table| %>
      <% table.with_head do |head| %>
        <% head.with_row do |row| %>
          <% row.with_cell(text: "Question", classes: "govuk-!-width-one-half") %>
          <% row.with_cell(text: "Answer") %>
        <% end %>
      <% end %>

      <% table.with_body do |body| %>
        <% @enforcement.proposal_details.each_with_index do |proposal_detail, index| %>
          <% body.with_row do |row| %>
            <%= row.with_cell(text: "#{index + 1}. #{proposal_detail.question}") %>
            <%= row.with_cell(text: proposal_detail.response_values.join(", ").to_s, classes: "govuk-!-font-weight-bold") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= accordion.with_section(heading_text: "Site location") do %>
    <p>This digital red line boundary was submitted by the complainant.</p>
    <%= render "shared/location_map", locals: {in_accordion: true, geojson: @enforcement.boundary_geojson} %>
  <% end %>

  <%= accordion.with_section(heading_text: "Complainant details") do %>
    <% @enforcement.complainants.each do |complainant| %>
      <%= next unless complainant.persisted? %>

      <%= govuk_summary_list( rows: [
          {key: {text:'Name'}, value: {text: complainant.name}},
          {key: {text: 'Address'}, value: {text: complainant.address}},
          {key: {text: 'Email'}, value: {text: complainant.email}}
      ]) %>
    <% end %>

    <% if @task.nil? %>
      <%= govuk_details(summary_text: "Add new complainant") do %>
        <%= form_with model: @complainant, url: complainants_path(@enforcement) do |form| %>
          <%= form.govuk_error_summary %>

          <%= form.govuk_fieldset(legend: nil, class: "display-flex", style: "gap: 36px") do %>
            <%= form.govuk_text_field :first_name, required: true, label: {text: "First name"} %>
            <%= form.govuk_text_field :last_name, required: true, label: {text: "Last name"} %>
          <% end %>

          <%= form.govuk_text_field :email, width: 'one-half' %>

          <%= form.govuk_fieldset(legend: nil) do %>
            <%= form.govuk_text_field :address_1, width: 'one-half', label: {text: "Address line 1"} %>
            <%= form.govuk_text_field :address_2, width: 'one-half', label: {text: "Address line 2"} %>
            <%= form.govuk_text_field :town, width: 'one-half' %>
            <%= form.govuk_text_field :county, width: 'one-half' %>
            <%= form.govuk_text_field :postcode, width: 'one-quarter' %>
          <% end %>

          <%= form.govuk_submit "Add complainant", secondary: true %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= accordion.with_section(heading_text: "Documents and Photos") do %>
    <div class="govuk-grid-row">
      <div
        class="govuk-grid-column-full"
        data-application-reference-value="<%= @enforcement.reference %>"
      >
        <div id="check-tag-documents-tasks">
          <p>
            <%= govuk_link_to "Manage documents and photos", task_path(@enforcement, "check-breach-report/documents-and-photos") %>
          </p>

          <%= render "bops_enforcements/shared/documents", enforcement: @enforcement, documents: @documents %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
