<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1>
      Enforcement cases
    </h1>

    <p class="govuk-body-m">
      <strong><%= current_user.name %>,</strong> <%= role_name %>
    </p>
  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <div class="govuk-tabs">
      <h2 class="govuk-tabs__title">Contents</h2>

      <ul class="govuk-tabs__list">
        <% %w[index unassigned  closed updated all].each do |tab_scope| %>
          <%= tag.li class: class_names("govuk-tabs__list-item", "govuk-tabs__list-item--selected": tab_scope == action_name) do %>
            <%= link_to route_for(tab_scope == "index" ? :enforcements : "#{tab_scope}_enforcements"), class: "govuk-tabs__tab" do %>
              <%= t(tab_scope, scope: 'bops_enforcements.index.tabs') %>
            <% end %>
          <% end %>
        <% end %>
      </ul>

      <div id="text" class="govuk-tabs__panel">
        <% if action_name == "updated" %>
          <%= render BopsEnforcements::UpdatedPanelComponent.new(
              search: @search,
              tab_route: :enforcements_path,
              audits: @audits
          ) %>
        <% else %>
          <%= render BopsEnforcements::PanelComponent.new(
            enforcements: @enforcements,
            type: action_name,
            search: @search,
            attributes: @attributes,
        ) %>
        <% end %>
      </div>
    </div>
  </div>
</div>
