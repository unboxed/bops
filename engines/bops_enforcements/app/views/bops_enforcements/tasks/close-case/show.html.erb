<% if @enforcement.requested_closure? && current_user.reviewer? %>
  <%= render "bops_enforcements/enforcements/enforcement", task: @task, enforcement: @enforcement, title: "Sign off case closure" %>
  <p>
    Under council protocol, decisions to close a case without enforcement
    require formal managerial sign-off. The assigned officer has submitted a
    recommendation to close this case. Review the officer's recommendation below
    to approve or reject the closure.
  </p>

  <%= govuk_notification_banner(title_text: "Close case recommendation") do %>
    <h2>
      <%= @enforcement.closed_reason %>
    </h2>
  <% end %>

  <%= form_with model: @form, url: @form.url do |form| %>
    <%= form.govuk_radio_buttons_fieldset :closure_confirmation, legend: {size: "m", text: t(".confirmation.label")} do %>
      <%= form.govuk_radio_button :closure_confirmation, true , label: {text: t(".confirmation.yes")} %>

      <%= form.govuk_radio_button :closure_confirmation, false, label: {text: t(".confirmation.no")} do %>
        <%= form.govuk_text_area :closure_rejection_reason, label: {text: t(".confirmation.rejection_reason")} %>
      <% end %>
    <% end %>

    <%= form.govuk_task_button "Confirm", action: :sign_off_closure %>
  <% end %>
<% else %>
  <%= render "bops_enforcements/enforcements/enforcement", task: @task, enforcement: @enforcement %>

  <%= form_with model: @form, url: @form.url do |form| %>
    <%= form.govuk_radio_buttons_fieldset :reason, legend: {size: "m", text: t(".reason.legend")} do %>
      <% @form.reasons.each do |reason| %>
        <%= form.govuk_radio_button :reason, reason , label: {text: t(".reason.#{reason}")} %>
      <% end %>

      <%= form.govuk_radio_button :reason, "other", label: {text: t(".reason.other")} do %>
        <%= form.govuk_text_field :other_reason, label: {text: t(".reason.other_detail")} %>
      <% end %>
    <% end %>

    <%= form.govuk_text_area :detail, label: {text: t(".detail.label"), size: "m"}, hint: {text: t(".detail.hint")} %>

    <%= form.govuk_radio_buttons_fieldset :manager_approval, legend: {size: "m", text: t(".manager_approval.label")}, hint: {text: t(".manager_approval.hint")} do %>
      <%= form.govuk_radio_button :manager_approval, true , label: {text: t(".manager_approval.yes")} %>
      <%= form.govuk_radio_button :manager_approval, false, label: {text: t(".manager_approval.no")} %>
    <% end %>

    <%= form.govuk_task_button "Confirm and submit", action: :close_case do %>
      <%= govuk_button_link_to "Back", enforcement_path(@enforcement), secondary: true %>
    <% end %>
  <% end %>
<% end %>
