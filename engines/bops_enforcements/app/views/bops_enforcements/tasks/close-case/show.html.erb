<%= render "bops_enforcements/enforcements/enforcement", task: @task, enforcement: @enforcement %>

<%= form_with model: @form, url: @form.url do |form| %>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-three-quarters">
      <%= form.govuk_radio_buttons_fieldset :reason, legend: {size: "m", text: t(".reason.legend")} do %>
        <% @form.reasons.each do |reason| %>
          <%= form.govuk_radio_button :reason, reason , label: {text: t(".reason.#{reason}")} %>
        <% end %>

        <%= form.govuk_radio_button :reason, "other", label: {text: t(".reason.other")} do %>
          <%= form.govuk_text_field :other_reason, label: {text: t(".reason.other_detail")} %>
        <% end %>
      <% end %>

      <%= form.govuk_text_area :detail, label: {text: t(".detail.label"), size: "m"}, hint: {text: t(".detail.hint")} %>
    </div>
  </div>

  <%= form.govuk_task_button "Close case and notify complainant", action: :save_and_complete do %>
    <%= govuk_button_link_to "Back", enforcement_path(@enforcement), secondary: true %>
  <% end %>
<% end %>
