<%= render "bops_enforcements/enforcements/enforcement", task: @task, enforcement: @enforcement %>

<%= render "bops_enforcements/enforcements/accordion" %>

<%= form_with model: @form, url: @form.url, method: :patch do |form| %>
  <h2 class="govuk-!-margin-top-8">Check description</h2>

  <p class="govuk-body govuk-!-margin-bottom-1">
    <%= @enforcement.description %>
  </p>

  <%= govuk_link_to "Edit description", @task.tasks.find_by(slug: "check-description").edit_url, class: "govuk-body-small govuk-!-margin-top-1", no_visited_state: true %>

  <h2 class="govuk-!-margin-top-8">Is this case urgent?</h2>

  <%= render ErrorSummaryComponent.new(errors: @form.errors) %>

  <%= form.govuk_check_boxes_fieldset :urgent, legend: -> { "" } do %>
    <%= form.govuk_check_box :urgent, 1, 0,
        checked: @enforcement.urgent,
        label: {text: "Select here if the case is urgent"},
       multiple: false, link_errors: true,
       aria: {expanded: @enforcement.urgent} do
           form.govuk_text_field :urgency_reason, value: @enforcement.urgency_reason, label: {text: "Reason"}, link_errors: true
       end %>
  <% end %>

  <h2 class="govuk-!-margin-top-8">How to close this case</h2>

  <ul class="govuk-list govuk-list--bullet">
    <li>
      You can close a case directly if no further action is needed. This
      decision will <strong>not</strong> be sent for review.
    </li>

    <li>
      You can submit a recommendation to close the case if manager approval is
      required before the case can be archived, such as when action is not
      expedient.
    </li>
  </ul>

  <p>
    <%= govuk_link_to "Close case now", task_path(@enforcement, 'close-case') %>
  </p>

  <%= form.govuk_task_button "Save", class: "govuk-!-margin-top-8" %>
<% end %>
