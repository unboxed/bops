<%= render @enforcement, task: @task, title: "Edit description" %>

<div class="govuk-inset-text">
  <h3 class="govuk-heading-small">Existing description</h3>

  <p>
    <%= @enforcement.description %>
  </p>
</div>

<%= form_with model: @form, url: @form.url do |form| %>
  <%= form.govuk_text_area :description, label: {text: "Enter an amended description", tag: "h3", size: "m"}, rows: 5 %>

  <%= form.govuk_task_button "Save", action: :save_and_complete do %>
    <%= govuk_button_link_to "Back", @task.parent.url, secondary: true %>
  <% end %>
<% end %>
